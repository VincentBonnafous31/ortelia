{
  "$schema": "../../schemas/app.schema.json",
  "formatVersion": "0.6",
  "id": "annuaire",
  "name": "Annuaire des personnes",
  "languages": ["fr", "en"],

  "labels": [
    {
      "lang": "fr",
      "entries": [
        { "key": "Personne", "text": "Personne" },
        { "key": "Personne.identite", "text": "Identité" },
        { "key": "Personne.nom", "text": "Nom" },
        { "key": "Personne.prenom", "text": "Prénom" },
        { "key": "Personne.date_naissance", "text": "Né le" },
        { "key": "Personne.nombre_enfants", "text": "Enfants" },
        { "key": "Personne.taille", "text": "Taille" },
        { "key": "Personne.contact_autorise", "text": "Contact" },
        { "key": "Personne.situation", "text": "Situation" },
        { "key": "Personne.inscription", "text": "Inscription" },
        { "key": "Personne.notes", "text": "Notes" },
        { "key": "SituationFamiliale.CELIBATAIRE", "text": "Célibataire" },
        { "key": "SituationFamiliale.MARIE", "text": "Marié(e)" },
        { "key": "SituationFamiliale.PACSE", "text": "Pacsé(e)" },
        { "key": "SituationFamiliale.DIVORCE", "text": "Divorcé(e)" },
        { "key": "SituationFamiliale.VEUF", "text": "Veuf, veuve" }
      ]
    },
    {
      "lang": "en",
      "entries": [
        { "key": "Personne", "text": "Person" },
        { "key": "Personne.identite", "text": "Identity" },
        { "key": "Personne.nom", "text": "Last name" },
        { "key": "Personne.prenom", "text": "First name" },
        { "key": "Personne.date_naissance", "text": "Born" },
        { "key": "Personne.nombre_enfants", "text": "Children" },
        { "key": "Personne.taille", "text": "Height" },
        { "key": "Personne.contact_autorise", "text": "Contact" },
        { "key": "Personne.situation", "text": "Status" },
        { "key": "Personne.inscription", "text": "Registered" },
        { "key": "Personne.notes", "text": "Notes" },
        { "key": "SituationFamiliale.CELIBATAIRE", "text": "Single" },
        { "key": "SituationFamiliale.MARIE", "text": "Married" },
        { "key": "SituationFamiliale.PACSE", "text": "Civil union" },
        { "key": "SituationFamiliale.DIVORCE", "text": "Divorced" },
        { "key": "SituationFamiliale.VEUF", "text": "Widowed" }
      ]
    }
  ],

  "model": {
    "files": ["annuaire.model.json"],
    "root": "Racine"
  },

  "sources": [
    {
      "id": "personnes",
      "format": "json",
      "file": "personnes.json",
      "target": "/annuaire/personnes"
    }
  ],

  "presentations": [
    {
      "class": "Personne",
      "table": {
        "columns": [
          { "path": "nom", "width": 140 },
          { "path": "prenom", "width": 120 },
          { "path": "date_naissance", "format": "dd/MM/yyyy" },
          { "path": "nombre_enfants" },
          { "path": "taille" },
          { "path": "contact_autorise" },
          { "path": "situation" },
          { "path": "inscription" }
        ],
        "sort": [ { "path": "nom" }, { "path": "prenom" } ]
      },
      "form": {
        "elements": [
          { "_type_": "Group", "label": "Personne.identite", "elements": [
              { "_type_": "Field", "path": "nom" },
              { "_type_": "Field", "path": "prenom" },
              { "_type_": "Field", "path": "date_naissance",
                "widget": { "_type_": "DateField", "format": "d MMMM yyyy" } }
          ] },
          { "_type_": "Field", "path": "nombre_enfants" },
          { "_type_": "Field", "path": "taille" },
          { "_type_": "Field", "path": "contact_autorise" },
          { "_type_": "Field", "path": "situation" },
          { "_type_": "Field", "path": "inscription" },
          { "_type_": "Separator" },
          { "_type_": "Field", "path": "notes",
            "labelCell": { "span": 2 }, "cell": { "newRow": true, "span": 2 },
            "widget": { "_type_": "TextArea", "rows": 5 } }
        ]
      }
    }
  ],

  "window": {
    "title": "Annuaire",
    "width": 1000,
    "height": 700,
    "content": {
      "_type_": "Split",
      "id": "principal",
      "direction": "horizontal",
      "weights": [65, 35],
      "children": [
        {
          "_type_": "View",
          "id": "personnes",
          "widget": { "_type_": "Table" },
          "data": "/annuaire/personnes"
        },
        {
          "_type_": "View",
          "id": "proprietes",
          "widget": { "_type_": "Form", "class": "Personne" }
        }
      ]
    }
  }
}
