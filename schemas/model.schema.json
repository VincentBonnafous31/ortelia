{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelFile",
  "description": "A whole model file.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema of the file, for text editors: read and ignored.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "formatVersion": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageDef"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "formatVersion"
  ],
  "definitions": {
    "PackageDef": {
      "description": "A package: classes, enums, data types, and nested packages.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PackageDef"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClassDef"
          }
        },
        "enums": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EnumDef"
          }
        },
        "dataTypes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DataTypeDef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ClassDef": {
      "description": "A class, with its own attributes and containment references (not the inherited ones).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "superClass": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "abstract": {
          "type": "boolean",
          "default": false
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeDef"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReferenceDef"
          }
        },
        "constraints": {
          "description": "Not used yet.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConstraintDef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "AttributeDef": {
      "description": "An attribute: a value of a base type, an enum or a data type.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "lowerBound": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "upperBound": {
          "type": "integer",
          "format": "int32",
          "default": 1
        },
        "defaultValue": {
          "description": "Not used yet.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "unit": {
          "description": "The unit of the values (`m`, `kg`…), shown after the label in the headers of tables.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "identifier": {
          "description": "Not used yet.",
          "type": "boolean",
          "default": false
        },
        "refersTo": {
          "description": "Not used yet.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "ReferenceDef": {
      "description": "A containment reference: the children belong to the object that holds the reference.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "lowerBound": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "upperBound": {
          "description": "1 for a single reference, -1 (unbounded) or more than 1 for a list.",
          "type": "integer",
          "format": "int32",
          "default": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "ConstraintDef": {
      "description": "A constraint on a class. Not used yet.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "expression": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "expression"
      ]
    },
    "EnumDef": {
      "description": "An enum: an ordered list of literals.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "baseType": {
          "description": "Not used.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "literals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "literals"
      ]
    },
    "DataTypeDef": {
      "description": "A data type derived from another type (`baseType`), with restrictions not used yet.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "baseType": {
          "type": "string"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "minLength": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "maxLength": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "baseType"
      ]
    }
  }
}
