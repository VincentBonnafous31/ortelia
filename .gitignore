# Rust build output (normally kept in WSL via CARGO_TARGET_DIR, see CLAUDE.md)
/target/

# Private design notes: never published
/docs/cadrage-prive/

# Local Claude Code settings
/.claude/settings.local.json

# Editors and OS
*.swp
*~
.DS_Store
Thumbs.db

# Windows Sandbox: generated configuration, downloaded executables and logs (see tools/sandbox/)
/tools/sandbox/sandbox.wsb
/tools/sandbox/build/
/tools/sandbox/logs/

# Snapshot tests (egui_kittest): images written next to the references after a failure or an
# update; only the references (<name>.png) are versioned
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.diff.png
**/tests/snapshots/**/*.old.png

# Session state of the applications (window size, layout of the tables), written next to their
# app.json when they close: a state of use, not a part of the definition
*.session.json
*.session.json.*.tmp
